# Bind address. In production this should stay 127.0.0.1 - Apache is meant
# to be the only thing the internet can reach; the app holds no public
# socket. install.py defaults to this and warns if you override it to
# 0.0.0.0. Only change this if you know Apache is NOT fronting this box.
APP_HOST=127.0.0.1
APP_PORT=8000
# development | production. production enforces the fail-fast checks below
# (refuses to boot on an unsafe SECRET_KEY or missing ALLOWED_HOSTS) and
# turns on COOKIE_SECURE/HSTS by default. Use development only on a machine
# nothing but you can reach.
APP_ENV=development

# First-boot bootstrap ONLY. On an empty database these seed exactly one
# admin account with a forced password change at first login. Every boot
# after that ignores both values completely - they never resurrect a
# deleted account or overwrite a changed password. Safe (and recommended)
# to delete both lines once you've logged in and changed the password.
API_USERNAME=admin
API_PASSWORD=admin
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production - the app refuses to boot if this is missing,
# under 32 characters, or still the placeholder below.
SECRET_KEY=change-me-in-production

# The public hostname(s) this server answers on, comma-separated (e.g.
# zk.example.com). Requests with any other Host header are rejected before
# they reach a route. Required in production - the app refuses to boot
# without this set, or set to "*".
ALLOWED_HOSTS=

# Addresses trusted to hand the app an accurate X-Forwarded-For - i.e.
# Apache's own source address. Almost always 127.0.0.1 (and ::1 if either
# side prefers IPv6 loopback) when Apache and the app run on the same host.
# Get this wrong and per-device IP allowlisting (Devices -> per-device CIDR
# list) either fails closed (every device refused) or fails open (spoofable
# via a forged header) - see deploy/apache/zkteco-sync.conf.example for the
# full explanation.
TRUSTED_PROXIES=127.0.0.1,::1

# Whether the session cookie carries the Secure flag (HTTPS-only). Defaults
# to true in production, false in development - a plain-HTTP dev run would
# otherwise never get the cookie back from the browser. Only set this
# explicitly to override that default.
COOKIE_SECURE=

# A session is revoked after this many minutes of inactivity...
SESSION_IDLE_MINUTES=60
# ...or this many hours since login, whichever comes first, even with
# continuous activity.
SESSION_ABSOLUTE_HOURS=12

# Failed logins allowed before an account is locked out...
LOGIN_MAX_ATTEMPTS=5
# ...for this many minutes.
LOGIN_LOCKOUT_MINUTES=15

# Expose the interactive API docs (/docs, /redoc, /openapi.json). Leave
# false on a public-internet deployment - they hand an attacker a complete,
# browsable map of every endpoint. Turn on only for local API exploration.
ENABLE_DOCS=false

# Largest request body accepted, in bytes, on any route (default ~2 MiB).
# Oversized requests get a 413 before the body is fully buffered.
MAX_REQUEST_BYTES=2097152

# How long a device-pairing window (Devices -> open pairing) stays open, in
# minutes, before it auto-closes and unknown serials go back to being
# refused instead of queued for approval.
ADMS_PAIRING_MINUTES=15

# What a newly registered device's clock is assumed to be set to. ZKTeco
# terminals push a bare wall-clock time with no offset and no zone name, so
# something has to say what those digits mean - this is that answer, and it
# is stamped onto each device and snapshotted onto every attendance record.
# Nothing is ever converted: the punch time is stored and pushed exactly as
# the device reported it, with this label attached. Must be an IANA name
# (Asia/Dubai, Europe/London, America/New_York); the app refuses to start on
# a name the tz database does not know. Correct it per device afterwards in
# Devices -> Timezone if a terminal sits in another zone.
DEFAULT_DEVICE_TIMEZONE=Asia/Dubai

# DB_ENGINE options: mariadb, mysql, postgresql, mssql
DB_ENGINE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zkteco_sync
DB_USER=root
DB_PASSWORD=

# Only required when DB_ENGINE=mssql
# Common values:
#   ODBC Driver 17 for SQL Server
#   ODBC Driver 18 for SQL Server
#   SQL Server Native Client 11.0
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# MSSQL Windows Authentication: leave DB_USER and DB_PASSWORD both empty
# and the app will automatically use trusted_connection=yes (no credentials in URL)
